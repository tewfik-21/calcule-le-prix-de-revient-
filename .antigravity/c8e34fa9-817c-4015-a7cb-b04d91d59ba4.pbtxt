    instruction: "Transform the main App components to use brutalist dark theme, Space Grotesk display headings, uppercase statuses, and emerald-500 highlighting."
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"min-h-screen bg-slate-50 flex flex-col font-sans text-slate-800\" id=\"app-root\">\n      \n      {/* Header Bar */}\n      <header className=\"bg-slate-900 text-white shadow-md py-4 px-6 sticky top-0 z-40 flex items-center justify-between print:hidden\">\n        <div className=\"flex items-center gap-3\">\n          <button \n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"lg:hidden p-1 hover:bg-slate-800 rounded-md transition\"\n            id=\"mobile-menu-toggle\"\n          >\n            {mobileMenuOpen ? <X className=\"h-5 w-5\" /> : <Menu className=\"h-5 w-5\" />}\n          </button>\n          <div className=\"h-10 w-10 bg-blue-600 rounded-xl flex items-center justify-center text-white font-black text-lg shadow-inner\">\n            \342\232\222\357\270\217\n          </div>\n          <div>\n            <h1 className=\"text-sm font-bold tracking-tight\">Carri\303\250reCost v1.2</h1>\n            <p className=\"text-[10px] text-slate-400 font-mono\">{scenario.nom}</p>\n          </div>\n        </div>\n\n        {/* Global actions */}\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={() => setShowGlobalSettings(!showGlobalSettings)}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition ${\n              showGlobalSettings \n                ? \'bg-blue-600/30 text-blue-300 border border-blue-500/30\' \n                : \'bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700\'\n            }`}\n            id=\"toggle-settings-bar\"\n          >\n            <Settings2 className=\"h-4 w-4\" />\n            <span className=\"hidden sm:inline\">Param\303\250tres Globaux</span>\n          </button>\n\n          <button\n            onClick={handlePrint}\n            className=\"bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition\"\n            id=\"btn-print-report\"\n          >\n            <Printer className=\"h-4 w-4\" />\n            <span className=\"hidden sm:inline\">Imprimer / PDF</span>\n          </button>\n        </div>\n      </header>"
        replacement_content: "  return (\n    <div className=\"min-h-screen bg-zinc-950 flex flex-col font-sans text-zinc-100 border-8 border-zinc-900\" id=\"app-root\">\n      \n      {/* Header Bar */}\n      <header className=\"bg-zinc-900 text-white py-4 px-6 sticky top-0 z-40 flex items-center justify-between border-b border-zinc-800 print:hidden\">\n        <div className=\"flex items-center gap-3\">\n          <button \n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"lg:hidden p-1.5 hover:bg-zinc-800 rounded-none transition border border-zinc-700\"\n            id=\"mobile-menu-toggle\"\n          >\n            {mobileMenuOpen ? <X className=\"h-5 w-5\" /> : <Menu className=\"h-5 w-5\" />}\n          </button>\n          <div className=\"h-10 w-10 bg-emerald-500 flex items-center justify-center text-black font-black text-lg shadow-inner rounded-none\">\n            \342\232\222\357\270\217\n          </div>\n          <div>\n            <h1 className=\"text-xl font-black tracking-tighter leading-none\">QUARRY_CORE<span className=\"text-emerald-500\">.v1</span></h1>\n            <p className=\"text-[10px] text-zinc-500 font-mono uppercase tracking-widest\">{scenario.nom}</p>\n          </div>\n        </div>\n\n        {/* Global actions */}\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={() => setShowGlobalSettings(!showGlobalSettings)}\n            className={`flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold uppercase tracking-wider transition rounded-none border-2 ${\n              showGlobalSettings \n                ? \'bg-emerald-500 text-black border-emerald-500 font-black\' \n                : \'bg-zinc-900 hover:bg-zinc-800 text-zinc-300 border-zinc-800\'\n            }`}\n            id=\"toggle-settings-bar\"\n          >\n            <Settings2 className=\"h-4 w-4\" />\n            <span className=\"hidden sm:inline\">Param\303\250tres Globaux</span>\n          </button>\n\n          <button\n            onClick={handlePrint}\n            className=\"bg-zinc-900 hover:bg-zinc-800 text-zinc-300 border-2 border-zinc-800 px-3 py-1.5 text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 transition rounded-none\"\n            id=\"btn-print-report\"\n          >\n            <Printer className=\"h-4 w-4\" />\n            <span className=\"hidden sm:inline\">Imprimer / PDF</span>\n          </button>\n        </div>\n      </header>"
