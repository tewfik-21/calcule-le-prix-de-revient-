      replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;750;850&family=JetBrains+Mono:wght@400;500;650&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace;\n}\n\n@layer base {\n  body {\n    font-feature-settings: \"cv02\", \"cv03\", \"cv04\", \"cv11\";\n  }\n}\n\n/* Custom CSS Print Rules for professional corporate report exports */\n@media print {\n  /* Hide interactive elements and navigation rails */\n  header, \n  aside, \n  #global-settings-panel, \n  button, \n  form, \n  .print\\:hidden {\n    display: none !important;\n  }\n\n  /* Reset layout margins for standard letter/A4 printing */\n  body {\n    background-color: white !important;\n    color: black !important;\n    font-size: 12px !important;\n  }\n\n  main {\n    padding: 0 !important;\n    margin: 0 !important;\n    overflow: visible !important;\n    width: 100% !important;\n  }\n\n  /* Expand tables and containers to full width */\n  #app-root, \n  #main-content-panel {\n    display: block !important;\n    width: 100% !important;\n    padding: 0 !important;\n    margin: 0 !important;\n  }\n\n  /* Elevate table border visibility on high-resolution monochrome print */\n  table {\n    border-collapse: collapse !important;\n    width: 100% !important;\n  }\n\n  th, td {\n    border: 1px solid #cbd5e1 !important;\n    padding: 8px !important;\n  }\n\n  tr {\n    page-break-inside: avoid !important;\n  }\n\n  /* Refactor cards into clean, simple boxes */\n  .rounded-xl {\n    border-radius: 4px !important;\n    border: 1px solid #e2e8f0 !important;\n    box-shadow: none !important;\n    background: transparent !important;\n  }\n\n  #chart-bar-container,\n  #chart-pie-container {\n    page-break-inside: avoid !important;\n    margin-top: 20px !important;\n    margin-bottom: 20px !important;\n  }\n}\n"
