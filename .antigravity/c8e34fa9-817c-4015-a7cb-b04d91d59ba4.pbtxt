        target_content: "          {/* Top Global Parameter Editor Bar */}\n          {showGlobalSettings && (\n            <div className=\"bg-slate-800 text-white rounded-xl p-5 shadow-md border border-slate-700 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-4 items-end print:hidden\" id=\"global-settings-panel\">\n              \n              {/* Tonnage setting */}\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-300 uppercase tracking-wider mb-1.5 flex items-center gap-1\">\n                  <Calendar className=\"h-3.5 w-3.5 text-blue-400\" /> Tonnage Produit ({scenario.periode === \'mensuel\' ? \'Mois\' : \'An\'})\n                </label>\n                <div className=\"flex rounded-md shadow-2xs\">\n                  <input\n                    type=\"number\"\n                    min=\"1\"\n                    value={scenario.productionTonnage}\n                    onChange={e => setScenario(prev => ({ ...prev, productionTonnage: Math.max(1, Number(e.target.value)) }))}\n                    className=\"w-full bg-slate-900 border border-slate-700 rounded-l-md px-3 py-1.5 text-xs font-mono font-semibold focus:outline-hidden focus:border-blue-500\"\n                  />\n                  <span className=\"bg-slate-700 border-y border-r border-slate-700 px-2 rounded-r-md text-[10px] font-bold text-slate-300 flex items-center\">\n                    T\n                  </span>\n                </div>\n              </div>\n\n              {/* Timeframe selector */}\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-300 uppercase tracking-wider mb-1.5\">P\303\251riodicit\303\251 des Calculs</label>\n                <select\n                  value={scenario.periode}\n                  onChange={e => setScenario(prev => ({ ...prev, periode: e.target.value as \'mensuel\' | \'annuel\' }))}\n                  className=\"w-full bg-slate-900 border border-slate-700 rounded-md px-2 py-1.5 text-xs font-semibold focus:outline-hidden\"\n                >\n                  <option value=\"mensuel\">Calcul Mensuel</option>\n                  <option value=\"annuel\">Calcul Annuel</option>\n                </select>\n              </div>\n\n              {/* Sales price estimation */}\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-300 uppercase tracking-wider mb-1.5 flex items-center gap-1\">\n                  <DollarSign className=\"h-3.5 w-3.5 text-emerald-400\" /> Prix de Vente Moyen\n                </label>\n                <div className=\"flex rounded-md shadow-2xs\">\n                  <input\n                    type=\"number\"\n                    step=\"0.1\"\n                    min=\"0\"\n                    value={scenario.prixVenteMoyenParTonne}\n                    onChange={e => setScenario(prev => ({ ...prev, prixVenteMoyenParTonne: Math.max(0, Number(e.target.value)) }))}\n                    className=\"w-full bg-slate-900 border border-slate-700 rounded-l-md px-3 py-1.5 text-xs font-mono font-semibold focus:outline-hidden focus:border-blue-500\"\n                  />\n                  <span className=\"bg-slate-700 border-y border-r border-slate-700 px-2 rounded-r-md text-[10px] font-bold text-slate-300 flex items-center\">\n                    {scenario.devise}/T\n                  </span>\n                </div>\n              </div>\n\n              {/* Currency configuration */}\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-300 uppercase tracking-wider mb-1.5\">Devise d\'affichage</label>\n                <select\n                  value={scenario.devise}\n                  onChange={e => setScenario(prev => ({ ...prev, devise: e.target.value }))}\n                  className=\"w-full bg-slate-900 border border-slate-700 rounded-md px-2.5 py-1.5 text-xs font-semibold focus:outline-hidden\"\n                >\n                  <option value=\"\342\202\254\">Euro (\342\202\254)</option>\n                  <option value=\"DA\">Dinar Alg\303\251rien (DA)</option>\n                  <option value=\"DA (Dinars)\">DA (Dinars)</option>\n                  <option value=\"$\">Dollar ($)</option>\n                  <option value=\"CFA\">Franc CFA (CFA)</option>\n                  <option value=\"DH\">Dirham (DH)</option>\n                </select>\n              </div>\n\n              {/* Fuel Price & Propagation Tool */}\n              <div className=\"bg-slate-900/60 p-2.5 rounded-lg border border-slate-750/50 space-y-2 lg:col-span-2 xl:col-span-1\">\n                <div className=\"flex items-center justify-between\">\n                  <label className=\"block text-[10px] font-bold text-slate-300 uppercase tracking-wider flex items-center gap-1\">\n                    \342\233\275 Gasoil Moyen\n                  </label>\n                  <span className=\"text-[9px] text-slate-500 font-mono\">Aligner</span>\n                </div>\n                <div className=\"flex gap-1.5\">\n                  <input\n                    type=\"number\"\n                    step=\"0.01\"\n                    min=\"0.01\"\n                    value={scenario.prixGasoilMoyen}\n                    onChange={e => setScenario(prev => ({ ...prev, prixGasoilMoyen: Math.max(0.01, Number(e.target.value)) }))}\n                    className=\"w-18 bg-slate-900 border border-slate-700 rounded-md px-2.5 py-1 text-xs font-mono text-center\"\n                  />\n                  <button\n                    onClick={handleSyncGasoilPrice}\n                    className=\"flex-1 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-[10px] font-bold transition flex items-center justify-center gap-1 py-1 px-1.5\"\n                    title=\"Synchroniser toutes les machines \303\240 ce tarif\"\n                  >\n                    <RefreshCcw className=\"h-3 w-3 shrink-0\" /> Propager\n                  </button>\n                </div>\n              </div>\n\n            </div>\n          )}"
        replacement_content: "          {/* Top Global Parameter Editor Bar */}\n          {showGlobalSettings && (\n            <div className=\"bg-zinc-900 text-white rounded-none p-5 border-2 border-zinc-800 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-4 items-end print:hidden\" id=\"global-settings-panel\">\n              \n              {/* Tonnage setting */}\n              <div>\n                <label className=\"block text-[10px] font-black text-zinc-400 uppercase tracking-wider mb-1.5 flex items-center gap-1\">\n                  <Calendar className=\"h-3.5 w-3.5 text-emerald-500\" /> Tonnage Produit ({scenario.periode === \'mensuel\' ? \'Mois\' : \'An\'})\n                </label>\n                <div className=\"flex rounded-none shadow-2xs\">\n                  <input\n                    type=\"number\"\n                    min=\"1\"\n                    value={scenario.productionTonnage}\n                    onChange={e => setScenario(prev => ({ ...prev, productionTonnage: Math.max(1, Number(e.target.value)) }))}\n                    className=\"w-full bg-zinc-950 border-2 border-zinc-850 px-3 py-1.5 text-xs font-mono font-bold focus:outline-none focus:border-emerald-500\"\n                  />\n                  <span className=\"bg-zinc-850 border-y-2 border-r-2 border-zinc-850 px-3 text-[10px] font-black text-zinc-400 flex items-center\">\n                    T\n                  </span>\n                </div>\n              </div>\n\n              {/* Timeframe selector */}\n              <div>\n                <label className=\"block text-[10px] font-black text-zinc-400 uppercase tracking-wider mb-1.5\">P\303\251riodicit\303\251 des Calculs</label>\n                <select\n                  value={scenario.periode}\n                  onChange={e => setScenario(prev => ({ ...prev, periode: e.target.value as \'mensuel\' | \'annuel\' }))}\n                  className=\"w-full bg-zinc-950 border-2 border-zinc-850 px-2.5 py-1.5 text-xs font-bold text-white focus:outline-none focus:border-emerald-500\"\n                >\n                  <option value=\"mensuel\">Calcul Mensuel</option>\n                  <option value=\"annuel\">Calcul Annuel</option>\n                </select>\n              </div>\n\n              {/* Sales price estimation */}\n              <div>\n                <label className=\"block text-[10px] font-black text-zinc-400 uppercase tracking-wider mb-1.5 flex items-center gap-1\">\n                  <DollarSign className=\"h-3.5 w-3.5 text-emerald-400\" /> Prix de Vente Moyen\n                </label>\n                <div className=\"flex rounded-none shadow-2xs\">\n                  <input\n                    type=\"number\"\n                    step=\"0.1\"\n                    min=\"0\"\n                    value={scenario.prixVenteMoyenParTonne}\n                    onChange={e => setScenario(prev => ({ ...prev, prixVenteMoyenParTonne: Math.max(0, Number(e.target.value)) }))}\n                    className=\"w-full bg-zinc-950 border-2 border-zinc-850 px-3 py-1.5 text-xs font-mono font-bold focus:outline-none focus:border-emerald-500\"\n                  />\n                  <span className=\"bg-zinc-850 border-y-2 border-r-2 border-zinc-850 px-3 text-[10px] font-black text-zinc-400 flex items-center\">\n                    {scenario.devise}/T\n                  </span>\n                </div>\n              </div>\n\n              {/* Currency configuration */}\n              <div>\n                <label className=\"block text-[10px] font-black text-zinc-400 uppercase tracking-wider mb-1.5\">Devise d\'affichage</label>\n                <select\n                  value={scenario.devise}\n                  onChange={e => setScenario(prev => ({ ...prev, devise: e.target.value }))}\n                  className=\"w-full bg-zinc-950 border-2 border-zinc-850 px-2.5 py-1.5 text-xs font-bold text-white focus:outline-none focus:border-emerald-500\"\n                >\n                  <option value=\"\342\202\254\">Euro (\342\202\254)</option>\n                  <option value=\"DA\">Dinar Alg\303\251rien (DA)</option>\n                  <option value=\"DA (Dinars)\">DA (Dinars)</option>\n                  <option value=\"$\">Dollar ($)</option>\n                  <option value=\"CFA\">Franc CFA (CFA)</option>\n                  <option value=\"DH\">Dirham (DH)</option>\n                </select>\n              </div>\n\n              {/* Fuel Price & Propagation Tool */}\n              <div className=\"bg-zinc-950/60 p-2.5 border-2 border-zinc-800 space-y-2 lg:col-span-2 xl:col-span-1\">\n                <div className=\"flex items-center justify-between\">\n                  <label className=\"block text-[10px] font-black text-zinc-400 uppercase tracking-wider flex items-center gap-1\">\n                    \342\233\275 Gasoil Moyen\n                  </label>\n                  <span className=\"text-[9px] text-zinc-500 font-mono\">Aligner</span>\n                </div>\n                <div className=\"flex gap-1.5\">\n                  <input\n                    type=\"number\"\n                    step=\"0.01\"\n                    min=\"0.01\"\n                    value={scenario.prixGasoilMoyen}\n                    onChange={e => setScenario(prev => ({ ...prev, prixGasoilMoyen: Math.max(0.01, Number(e.target.value)) }))}\n                    className=\"w-18 bg-zinc-950 border-2 border-zinc-800 text-xs font-mono text-center\"\n                  />\n                  <button\n                    onClick={handleSyncGasoilPrice}\n                    className=\"flex-1 bg-emerald-500 hover:bg-emerald-400 text-black text-[10px] font-black uppercase tracking-wider transition flex items-center justify-center gap-1 py-1 px-1.5\"\n                    title=\"Synchroniser toutes les machines \303\240 ce tarif\"\n                  >\n                    <RefreshCcw className=\"h-3 w-3 shrink-0\" /> Propager\n                  </button>\n                </div>\n              </div>\n\n            </div>\n          )}"
