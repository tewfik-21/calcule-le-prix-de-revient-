    instruction: "Update index.css to implement the Bold Typography dark brutalist theme including colors, fonts, flat borders, and emerald accents."
    replacement_infos {
      original_chunk {
        target_content: "@import url(\'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;750;850&family=JetBrains+Mono:wght@400;500;650&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace;\n}\n\n@layer base {\n  body {\n    font-feature-settings: \"cv02\", \"cv03\", \"cv04\", \"cv11\";\n  }\n}"
        replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700;900&family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400;700;900&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Space Grotesk\", \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace;\n}\n\n@layer base {\n  body {\n    font-feature-settings: \"cv02\", \"cv03\", \"cv04\", \"cv11\";\n    background-color: #09090b;\n    color: #ffffff;\n  }\n}\n\n/* ==========================================================================\n   BOLD TYPOGRAPHY / DARK BRUTALIST GLOBAL OVERRIDES\n   ========================================================================== */\n\n/* App Container and background */\n#app-root {\n  background-color: #09090b !important;\n  color: #f4f4f5 !important;\n  font-family: \"Space Grotesk\", \"Inter\", sans-serif !important;\n}\n\n/* Navigation Sidebar override */\n#main-sidebar {\n  background-color: #09090b !important;\n  border-right: 2px solid #27272a !important;\n  border-radius: 0px !important;\n}\n\n/* Header override */\nheader.sticky {\n  background-color: #18181b !important;\n  border-bottom: 2px solid #27272a !important;\n}\n\n/* Headings: Extra black, tight spacing, uppercase style */\nh1, h2, h3, h4, h5, h6 {\n  font-weight: 900 !important;\n  letter-spacing: -0.05em !important;\n  text-transform: uppercase !important;\n}\n\n/* Flat brutalist panels instead of soft rounded cards */\n.rounded-xl, .rounded-lg, .rounded-md, .rounded-sm, .rounded-2xl {\n  border-radius: 0px !important;\n}\n\n/* Replace white cards with zinc-900 cards */\n.bg-white {\n  background-color: #18181b !important;\n  color: #ffffff !important;\n  border-color: #27272a !important;\n}\n\n/* Slate/grey backgrounds to deep dark zinc-950 */\n.bg-slate-50, .bg-slate-100, .bg-slate-50\\/20, .bg-slate-50\\/50, .bg-slate-100\\/50, .bg-slate-100\\/70, .bg-slate-200 {\n  background-color: #09090b !important;\n  color: #f4f4f5 !important;\n}\n\n.border-slate-100, .border-slate-150, .border-slate-200, .border-slate-300, .border-blue-100 {\n  border-color: #27272a !important;\n}\n\n/* Text color overrides */\n.text-slate-900, .text-slate-800, .text-slate-700 {\n  color: #ffffff !important;\n}\n\n.text-slate-600, .text-slate-500, .text-slate-400 {\n  color: #a1a1aa !important; /* zinc-400 */\n}\n\n/* Specific component transformations */\n#toggle-settings-bar, #btn-print-report, #toggle-saisie-directe, #toggle-personnel-direct {\n  border-radius: 0px !important;\n}\n\n/* Form Inputs styling */\ninput[type=\"text\"], input[type=\"number\"], select, textarea {\n  background-color: #09090b !important;\n  border: 2px solid #27272a !important;\n  color: #ffffff !important;\n  border-radius: 0px !important;\n  font-family: \"JetBrains Mono\", monospace !important;\n  font-weight: 700 !important;\n}\n\ninput[type=\"text\"]:focus, input[type=\"number\"]:focus, select:focus, textarea:focus {\n  border-color: #10b981 !important; /* emerald-500 */\n  outline: none !important;\n}\n\n/* Tables style */\ntable {\n  border-collapse: collapse !important;\n}\n\nth {\n  background-color: #18181b !important;\n  color: #a1a1aa !important;\n  font-weight: 900 !important;\n  border-bottom: 2px solid #27272a !important;\n}\n\ntd {\n  border-bottom: 1px solid #27272a !important;\n  font-family: \"JetBrains Mono\", monospace !important;\n}\n\ntr:hover {\n  background-color: #27272a / 20% !important;\n}\n\n/* Scrollbars */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n::-webkit-scrollbar-track {\n  background: #09090b;\n}\n::-webkit-scrollbar-thumb {\n  background: #27272a;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #3f3f46;\n}"
      }
