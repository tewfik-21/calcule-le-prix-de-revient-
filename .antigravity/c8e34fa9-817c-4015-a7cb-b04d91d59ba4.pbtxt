        target_content: "        <aside className={`\n          fixed inset-y-0 left-0 transform lg:static lg:translate-x-0 transition-transform duration-300 ease-in-out\n          w-64 bg-white border-r border-slate-150 p-5 flex flex-col justify-between z-30 print:hidden shrink-0\n          ${mobileMenuOpen ? \'translate-x-0\' : \'-translate-x-full lg:block\'}\n        `} id=\"main-sidebar\">\n          \n          <div className=\"space-y-6\">\n            <div>\n              <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-2.5\">Menu Principal</span>\n              <nav className=\"space-y-1\">\n                <button\n                  onClick={() => { setActiveTab(\'dashboard\'); setMobileMenuOpen(false); }}\n                  className={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-xs font-bold transition ${\n                    activeTab === \'dashboard\'\n                      ? \'bg-blue-50 text-blue-700 shadow-2xs\'\n                      : \'text-slate-600 hover:bg-slate-50\'\n                  }`}\n                  id=\"nav-btn-dashboard\"\n                >\n                  <BarChart3 className=\"h-4.5 w-4.5\" />\n                  Tableau de Bord\n                </button>\n                <button\n                  onClick={() => { setActiveTab(\'scenarios\'); setMobileMenuOpen(false); }}\n                  className={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-xs font-bold transition ${\n                    activeTab === \'scenarios\'\n                      ? \'bg-blue-50 text-blue-700 shadow-2xs\'\n                      : \'text-slate-600 hover:bg-slate-50\'\n                  }`}\n                  id=\"nav-btn-scenarios\"\n                >\n                  <FolderLock className=\"h-4.5 w-4.5\" />\n                  Gestion des Sc\303\251narios\n                </button>\n              </nav>\n            </div>\n\n            {/* Production categories */}\n            <div>\n              <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-2.5\">Rubriques de Production</span>\n              <nav className=\"space-y-1\">\n                {[\n                  { id: \'front_de_taille\', label: \'1. Front de Taille\', desc: \'Extraction & Forage\', icon: <Flame className=\"h-4 w-4\" /> },\n                  { id: \'transport\', label: \'2. Transport & Roulage\', desc: \'Transfert au concasseur\', icon: <Truck className=\"h-4 w-4\" /> },\n                  { id: \'concassage\', label: \'3. Concassage\', desc: \'R\303\251duction & Criblage\', icon: <Hammer className=\"h-4 w-4\" /> },\n                  { id: \'chargement\', label: \'4. Chargement\', desc: \'Vente & Exp\303\251dition\', icon: <PackageCheck className=\"h-4 w-4\" /> },\n                  { id: \'moyens_generaux\', label: \'5. Moyens G\303\251n\303\251raux\', desc: \'Ateliers & Administration\', icon: <Briefcase className=\"h-4 w-4\" /> }\n                ].map((item) => (\n                  <button\n                    key={item.id}\n                    onClick={() => { setActiveTab(item.id as any); setMobileMenuOpen(false); }}\n                    className={`w-full text-left px-3.5 py-2.5 rounded-lg transition ${\n                      activeTab === item.id\n                        ? \'bg-blue-50 border border-blue-100 text-blue-700 shadow-2xs\'\n                        : \'border border-transparent text-slate-600 hover:bg-slate-50\'\n                    }`}\n                    id={`nav-btn-${item.id}`}\n                  >\n                    <div className=\"flex items-center gap-2.5 font-bold text-xs\">\n                      {item.icon}\n                      <span>{item.label}</span>\n                    </div>\n                    <span className=\"text-[10px] text-slate-500 font-normal block ml-6 mt-0.5\">{item.desc}</span>\n                  </button>\n                ))}\n              </nav>\n            </div>\n          </div>\n\n          {/* Quick Stats Widget in Sidebar */}\n          <div className=\"pt-4 border-t border-slate-100 mt-6 space-y-2.5 text-xs font-medium\" id=\"sidebar-stats-widget\">\n            <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider block\">Co\303\273t Actuel</span>\n            <div className=\"bg-slate-50 p-3 rounded-lg border border-slate-150 space-y-1.5 font-mono\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500\">Total :</span>\n                <span className=\"font-bold text-slate-800\">{formatCurrency(summary.totalGlobal, scenario.devise)}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500\">Tonne :</span>\n                <span className=\"font-bold text-blue-700\">{formatCostPerTon(summary.coutParTonneGlobal, scenario.devise)}</span>\n              </div>\n            </div>\n          </div>\n        </aside>"
        replacement_content: "        <aside className={`\n          fixed inset-y-0 left-0 transform lg:static lg:translate-x-0 transition-transform duration-300 ease-in-out\n          w-64 bg-zinc-950 border-r-2 border-zinc-800 p-5 flex flex-col justify-between z-30 print:hidden shrink-0\n          ${mobileMenuOpen ? \'translate-x-0\' : \'-translate-x-full lg:block\'}\n        `} id=\"main-sidebar\">\n          \n          <div className=\"space-y-6\">\n            <div>\n              <span className=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest block mb-3\">Menu Principal</span>\n              <nav className=\"space-y-2\">\n                <button\n                  onClick={() => { setActiveTab(\'dashboard\'); setMobileMenuOpen(false); }}\n                  className={`w-full flex items-center gap-3 px-3.5 py-3 text-xs font-black uppercase tracking-wider transition rounded-none border-2 ${\n                    activeTab === \'dashboard\'\n                      ? \'bg-emerald-500 text-black border-emerald-500 font-black\'\n                      : \'text-zinc-400 bg-zinc-900/50 border-zinc-800 hover:bg-zinc-900 hover:text-white\'\n                  }`}\n                  id=\"nav-btn-dashboard\"\n                >\n                  <BarChart3 className=\"h-4.5 w-4.5\" />\n                  Tableau de Bord\n                </button>\n                <button\n                  onClick={() => { setActiveTab(\'scenarios\'); setMobileMenuOpen(false); }}\n                  className={`w-full flex items-center gap-3 px-3.5 py-3 text-xs font-black uppercase tracking-wider transition rounded-none border-2 ${\n                    activeTab === \'scenarios\'\n                      ? \'bg-emerald-500 text-black border-emerald-500 font-black\'\n                      : \'text-zinc-400 bg-zinc-900/50 border-zinc-800 hover:bg-zinc-900 hover:text-white\'\n                  }`}\n                  id=\"nav-btn-scenarios\"\n                >\n                  <FolderLock className=\"h-4.5 w-4.5\" />\n                  Gestion des Sc\303\251narios\n                </button>\n              </nav>\n            </div>\n\n            {/* Production categories */}\n            <div>\n              <span className=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest block mb-3\">Rubriques de Production</span>\n              <nav className=\"space-y-2\">\n                {[\n                  { id: \'front_de_taille\', label: \'01. Front de Taille\', desc: \'Extraction & Forage\', icon: <Flame className=\"h-4 w-4\" /> },\n                  { id: \'transport\', label: \'02. Transport\', desc: \'Transfert au concasseur\', icon: <Truck className=\"h-4 w-4\" /> },\n                  { id: \'concassage\', label: \'03. Concassage\', desc: \'R\303\251duction & Criblage\', icon: <Hammer className=\"h-4 w-4\" /> },\n                  { id: \'chargement\', label: \'04. Chargement\', desc: \'Vente & Exp\303\251dition\', icon: <PackageCheck className=\"h-4 w-4\" /> },\n                  { id: \'moyens_generaux\', label: \'05. Moyens G\303\251n\303\251raux\', desc: \'Ateliers & Admin\', icon: <Briefcase className=\"h-4 w-4\" /> }\n                ].map((item) => (\n                  <button\n                    key={item.id}\n                    onClick={() => { setActiveTab(item.id as any); setMobileMenuOpen(false); }}\n                    className={`w-full text-left p-4 rounded-none border-2 transition flex flex-col ${\n                      activeTab === item.id\n                        ? \'bg-emerald-500 text-black border-emerald-500\'\n                        : \'text-zinc-400 bg-zinc-900/50 border-zinc-800 hover:bg-zinc-900/80 hover:text-white\'\n                    }`}\n                    id={`nav-btn-${item.id}`}\n                  >\n                    <div className=\"flex items-center gap-2 font-black text-xs uppercase tracking-wider\">\n                      {item.icon}\n                      <span>{item.label}</span>\n                    </div>\n                    <span className={`text-[10px] uppercase font-bold mt-1 block tracking-tight ${activeTab === item.id ? \'text-black/80\' : \'text-zinc-500\'}`}>{item.desc}</span>\n                  </button>\n                ))}\n              </nav>\n            </div>\n          </div>\n\n          {/* Quick Stats Widget in Sidebar */}\n          <div className=\"pt-4 border-t-2 border-zinc-800 mt-6 space-y-2.5 text-xs font-medium\" id=\"sidebar-stats-widget\">\n            <span className=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest block\">Co\303\273t Actuel</span>\n            <div className=\"bg-zinc-900 p-4 border-2 border-zinc-800 space-y-2 font-mono\">\n              <div className=\"flex justify-between items-center\">\n                <span className=\"text-zinc-400 text-[10px] uppercase font-bold\">Total :</span>\n                <span className=\"font-black text-white\">{formatCurrency(summary.totalGlobal, scenario.devise)}</span>\n              </div>\n              <div className=\"flex justify-between items-center\">\n                <span className=\"text-zinc-400 text-[10px] uppercase font-bold\">Tonne :</span>\n                <span className=\"font-black text-emerald-400 text-sm\">{formatCostPerTon(summary.coutParTonneGlobal, scenario.devise)}</span>\n              </div>\n            </div>\n          </div>\n        </aside>"
