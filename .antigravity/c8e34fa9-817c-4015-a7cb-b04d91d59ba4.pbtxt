    replacement_chunks {
      replacement_content: "import { useState, useEffect } from \'react\';\nimport { QuarryScenario, ProcessusCostData } from \'./types\';\nimport { generateDefaultScenario } from \'./data/defaultTemplates\';\nimport { calculateScenarioSummary } from \'./utils/calculations\';\nimport { formatCurrency, formatCostPerTon, formatTonnage } from \'./utils/format\';\nimport { DashboardView } from \'./components/DashboardView\';\nimport { ProcessEditorView } from \'./components/ProcessEditorView\';\nimport { ScenarioManagerView } from \'./components/ScenarioManagerView\';\nimport { \n  BarChart3, \n  Layers, \n  Truck, \n  Hammer, \n  PackageCheck, \n  Settings2, \n  FolderLock, \n  Printer, \n  Flame, \n  RefreshCcw,\n  BookOpen,\n  Calendar,\n  DollarSign,\n  Briefcase,\n  Layers2,\n  Menu,\n  X\n} from \'lucide-react\';\n\nexport default function App() {\n  // Charger le sc\303\251nario par d\303\251faut\n  const [scenario, setScenario] = useState<QuarryScenario>(() => {\n    // Essayer de charger le dernier sc\303\251nario actif depuis localStorage\n    try {\n      const activeId = localStorage.getItem(\'quarry_active_scenario_id\');\n      if (activeId) {\n        const saved = localStorage.getItem(`quarry_scenario_${activeId}`);\n        if (saved) {\n          return JSON.parse(saved) as QuarryScenario;\n        }\n      }\n    } catch (e) {\n      console.error(\"Erreur de restauration de session\", e);\n    }\n    return generateDefaultScenario();\n  });\n\n  const [activeTab, setActiveTab] = useState<\'dashboard\' | \'front_de_taille\' | \'transport\' | \'concassage\' | \'chargement\' | \'moyens_generaux\' | \'scenarios\'>(\'dashboard\');\n  const [showGlobalSettings, setShowGlobalSettings] = useState<boolean>(true);\n  const [mobileMenuOpen, setMobileMenuOpen] = useState<boolean>(false);\n\n  // Sauvegarde automatique du sc\303\251nario actif\n  useEffect(() => {\n    try {\n      localStorage.setItem(`quarry_scenario_${scenario.id}`, JSON.stringify(scenario));\n      localStorage.setItem(\'quarry_active_scenario_id\', scenario.id);\n    } catch (e) {\n      console.error(\"Erreur d\'auto-sauvegarde\", e);\n    }\n  }, [scenario]);\n\n  // Recalculateur global pour le r\303\251sum\303\251 actuel\n  const summary = calculateScenarioSummary(scenario);\n\n  // Actions de mise \303\240 jour de donn\303\251es\n  const handleUpdateProcessus = (updatedProcessus: ProcessusCostData) => {\n    setScenario(prev => ({\n      ...prev,\n      processus: {\n        ...prev.processus,\n        [updatedProcessus.id]: updatedProcessus\n      }\n    }));\n  };\n\n  const handleSaveCurrentScenario = (customName: string) => {\n    setScenario(prev => {\n      const updated = {\n        ...prev,\n        nom: customName,\n        dateCreation: new Date().toLocaleDateString(\'fr-FR\')\n      };\n      // Sauvegarder imm\303\251diatement\n      localStorage.setItem(`quarry_scenario_${updated.id}`, JSON.stringify(updated));\n      return updated;\n    });\n  };\n\n  const handleLoadScenario = (loaded: QuarryScenario) => {\n    setScenario(loaded);\n    setActiveTab(\'dashboard\');\n    setMobileMenuOpen(false);\n  };\n\n  // Aligner le prix du gasoil pour TOUTES les machines internes d\'un seul coup\n  const handleSyncGasoilPrice = () => {\n    const updated = { ...scenario };\n    const keys: (\'front_de_taille\' | \'transport\' | \'concassage\' | \'chargement\' | \'moyens_generaux\')[] = [\n      \'front_de_taille\',\n      \'transport\',\n      \'concassage\',\n      \'chargement\',\n      \'moyens_generaux\'\n    ];\n\n    keys.forEach(key => {\n      updated.processus[key].machinesInternes = updated.processus[key].machinesInternes.map(m => ({\n        ...m,\n        prixGasoilLitre: scenario.prixGasoilMoyen\n      }));\n    });\n\n    setScenario(updated);\n    alert(`Le prix du gasoil de toutes les machines internes a \303\251t\303\251 synchronis\303\251 \303\240 ${scenario.prixGasoilMoyen} ${scenario.devise}/L !`);\n  };\n\n  // Imprimer\n  const handlePrint = () => {\n    window.print();\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 flex flex-col font-sans text-slate-800\" id=\"app-root\">\n      \n      {/* Header Bar */}\n      <header className=\"bg-slate-900 text-white shadow-md py-4 px-6 sticky top-0 z-40 flex items-center justify-between print:hidden\">\n        <div className=\"flex items-center gap-3\">\n          <button \n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"lg:hidden p-1 hover:bg-slate-800 rounded-md transition\"\n            id=\"mobile-menu-toggle\"\n          >\n            {mobileMenuOpen ? <X className=\"h-5 w-5\" /> : <Menu className=\"h-5 w-5\" />}\n          </button>\n          <div className=\"h-10 w-10 bg-blue-600 rounded-xl flex items-center justify-center text-white font-black text-lg shadow-inner\">\n            \342\232\222\357\270\217\n          </div>\n          <div>\n            <h1 className=\"text-sm font-bold tracking-tight\">Carri\303\250reCost v1.2</h1>\n            <p className=\"text-[10px] text-slate-400 font-mono\">{scenario.nom}</p>\n          </div>\n        </div>\n\n        {/* Global actions */}\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={() => setShowGlobalSettings(!showGlobalSettings)}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition ${\n              showGlobalSettings \n                ? \'bg-blue-600/30 text-blue-300 border border-blue-500/30\' \n                : \'bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700\'\n            }`}\n            id=\"toggle-settings-bar\"\n          >\n            <Settings2 className=\"h-4 w-4\" />\n            <span className=\"hidden sm:inline\">Param\303\250tres Globaux</span>\n          </button>\n\n          <button\n            onClick={handlePrint}\n            className=\"bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition\"\n            id=\"btn-print-report\"\n          >\n            <Printer className=\"h-4 w-4\" />\n            <span className=\"hidden sm:inline\">Imprimer / PDF</span>\n          </button>\n        </div>\n      </header>\n\n      {/* Main layout container */}\n      <div className=\"flex-1 flex relative\">\n        \n        {/* Left Side Navigation Sidebar */}\n        <aside className={`\n          fixed inset-y-0 left-0 transform lg:static lg:translate-x-0 transition-transform duration-300 ease-in-out\n          w-64 bg-white border-r border-slate-150 p-5 flex flex-col justify-between z-30 print:hidden shrink-0\n          ${mobileMenuOpen ? \'translate-x-0\' : \'-translate-x-full lg:block\'}\n        `} id=\"main-sidebar\">\n          \n          <div className=\"space-y-6\">\n            <div>\n              <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-2.5\">Menu Principal</span>\n              <nav className=\"space-y-1\">\n                <button\n                  onClick={() => { setActiveTab(\'dashboard\'); setMobileMenuOpen(false); }}\n                  className={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-xs font-bold transition ${\n                    activeTab === \'dashboard\'\n                      ? \'bg-blue-50 text-blue-700 shadow-2xs\'\n                      : \'text-slate-600 hover:bg-slate-50\'\n                  }`}\n                  id=\"nav-btn-dashboard\"\n                >\n                  <BarChart3 className=\"h-4.5 w-4.5\" />\n                  Tableau de Bord\n                </button>\n                <button\n                  onClick={() => { setActiveTab(\'scenarios\'); setMobileMenuOpen(false); }}\n                  className={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-xs font-bold transition ${\n                    activeTab === \'scenarios\'\n                      ? \'bg-blue-50 text-blue-700 shadow-2xs\'\n                      : \'text-slate-600 hover:bg-slate-50\'\n                  }`}\n                  id=\"nav-btn-scenarios\"\n                >\n                  <FolderLock className=\"h-4.5 w-4.5\" />\n                  Gestion des Sc\303\251narios\n                </button>\n              </nav>\n            </div>\n\n            {/* Production categories */}\n            <div>\n              <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-2.5\">Rubriques de Production</span>\n              <nav className=\"space-y-1\">\n                {[\n                  { id: \'front_de_taille\', label: \'1. Front de Taille\', desc: \'Extraction & Forage\', icon: <Flame className=\"h-4 w-4\" /> },\n                  { id: \'transport\', label: \'2. Transport & Roulage\', desc: \'Transfert au concasseur\', icon: <Truck className=\"h-4 w-4\" /> },\n                  { id: \'concassage\', label: \'3. Concassage\', desc: \'R\303\251duction & Criblage\', icon: <Hammer className=\"h-4 w-4\" /> },\n                  { id: \'chargement\', label: \'4. Chargement\', desc: \'Vente & Exp\303\251dition\', icon: <PackageCheck className=\"h-4 w-4\" /> },\n                  { id: \'moyens_generaux\', label: \'5. Moyens G\303\251n\303\251raux\', desc: \'Ateliers & Administration\', icon: <Briefcase className=\"h-4 w-4\" /> }\n                ].map((item) => (\n                  <button\n                    key={item.id}\n                    onClick={() => { setActiveTab(item.id as any); setMobileMenuOpen(false); }}\n                    className={`w-full text-left px-3.5 py-2.5 rounded-lg transition ${\n                      activeTab === item.id\n                        ? \'bg-blue-50 border border-blue-100 text-blue-700 shadow-2xs\'\n                        : \'border border-transparent text-slate-600 hover:bg-slate-50\'\n                    }`}\n                    id={`nav-btn-${item.id}`}\n                  >\n                    <div className=\"flex items-center gap-2.5 font-bold text-xs\">\n                      {item.icon}\n                      <span>{item.label}</span>\n                    </div>\n                    <span className=\"text-[10px] text-slate-500 font-normal block ml-6 mt-0.5\">{item.desc}</span>\n                  </button>\n                ))}\n              </nav>\n            </div>\n          </div>\n\n          {/* Quick Stats Widget in Sidebar */}\n          <div className=\"pt-4 border-t border-slate-100 mt-6 space-y-2.5 text-xs font-medium\" id=\"sidebar-stats-widget\">\n            <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider block\">Co\303\273t Actuel</span>\n            <div className=\"bg-slate-50 p-3 rounded-lg border border-slate-150 space-y-1.5 font-mono\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500\">Total :</span>\n                <span className=\"font-bold text-slate-800\">{formatCurrency(summary.totalGlobal, scenario.devise)}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500\">Tonne :</span>\n                <span className=\"font-bold text-blue-700\">{formatCostPerTon(summary.coutParTonneGlobal, scenario.devise)}</span>\n              </div>\n            </div>\n          </div>\n        </aside>\n\n        {/* Content Panel */}\n        <main className=\"flex-1 p-6 md:p-8 overflow-y-auto space-y-6\" id=\"main-content-panel\">\n          \n          {/* Top Global Parameter Editor Bar */}\n          {showGlobalSettings && (\n            <div className=\"bg-slate-800 text-white rounded-xl p-5 shadow-md border border-slate-700 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-4 items-end print:hidden\" id=\"global-settings-panel\">\n              \n              {/* Tonnage setting */}\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-300 uppercase tracking-wider mb-1.5 flex items-center gap-1\">\n                  <Calendar className=\"h-3.5 w-3.5 text-blue-400\" /> Tonnage Produit ({scenario.periode === \'mensuel\' ? \'Mois\' : \'An\'})\n                </label>\n                <div className=\"flex rounded-md shadow-2xs\">\n                  <input\n                    type=\"number\"\n                    min=\"1\"\n                    value={scenario.productionTonnage}\n                    onChange={e => setScenario(prev => ({ ...prev, productionTonnage: Math.max(1, Number(e.target.value)) }))}\n                    className=\"w-full bg-slate-900 border border-slate-700 rounded-l-md px-3 py-1.5 text-xs font-mono font-semibold focus:outline-hidden focus:border-blue-500\"\n                  />\n                  <span className=\"bg-slate-700 border-y border-r border-slate-700 px-2 rounded-r-md text-[10px] font-bold text-slate-300 flex items-center\">\n                    T\n                  </span>\n                </div>\n              </div>\n\n              {/* Timeframe selector */}\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-300 uppercase tracking-wider mb-1.5\">P\303\251riodicit\303\251 des Calculs</label>\n                <select\n                  value={scenario.periode}\n                  onChange={e => setScenario(prev => ({ ...prev, periode: e.target.value as \'mensuel\' | \'annuel\' }))}\n                  className=\"w-full bg-slate-900 border border-slate-700 rounded-md px-2 py-1.5 text-xs font-semibold focus:outline-hidden\"\n                >\n                  <option value=\"mensuel\">Calcul Mensuel</option>\n                  <option value=\"annuel\">Calcul Annuel</option>\n                </select>\n              </div>\n\n              {/* Sales price estimation */}\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-300 uppercase tracking-wider mb-1.5 flex items-center gap-1\">\n                  <DollarSign className=\"h-3.5 w-3.5 text-emerald-400\" /> Prix de Vente Moyen\n                </label>\n                <div className=\"flex rounded-md shadow-2xs\">\n                  <input\n                    type=\"number\"\n                    step=\"0.1\"\n                    min=\"0\"\n                    value={scenario.prixVenteMoyenParTonne}\n                    onChange={e => setScenario(prev => ({ ...prev, prixVenteMoyenParTonne: Math.max(0, Number(e.target.value)) }))}\n                    className=\"w-full bg-slate-900 border border-slate-700 rounded-l-md px-3 py-1.5 text-xs font-mono font-semibold focus:outline-hidden focus:border-blue-500\"\n                  />\n                  <span className=\"bg-slate-700 border-y border-r border-slate-700 px-2 rounded-r-md text-[10px] font-bold text-slate-300 flex items-center\">\n                    {scenario.devise}/T\n                  </span>\n                </div>\n              </div>\n\n              {/* Currency configuration */}\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-300 uppercase tracking-wider mb-1.5\">Devise d\'affichage</label>\n                <select\n                  value={scenario.devise}\n                  onChange={e => setScenario(prev => ({ ...prev, devise: e.target.value }))}\n                  className=\"w-full bg-slate-900 border border-slate-700 rounded-md px-2.5 py-1.5 text-xs font-semibold focus:outline-hidden\"\n                >\n                  <option value=\"\342\202\254\">Euro (\342\202\254)</option>\n                  <option value=\"DA\">Dinar Alg\303\251rien (DA)</option>\n                  <option value=\"DA (Dinars)\">DA (Dinars)</option>\n                  <option value=\"$\">Dollar ($)</option>\n                  <option value=\"CFA\">Franc CFA (CFA)</option>\n                  <option value=\"DH\">Dirham (DH)</option>\n                </select>\n              </div>\n\n              {/* Fuel Price & Propagation Tool */}\n              <div className=\"bg-slate-900/60 p-2.5 rounded-lg border border-slate-750/50 space-y-2 lg:col-span-2 xl:col-span-1\">\n                <div className=\"flex items-center justify-between\">\n                  <label className=\"block text-[10px] font-bold text-slate-300 uppercase tracking-wider flex items-center gap-1\">\n                    \342\233\275 Gasoil Moyen\n                  </label>\n                  <span className=\"text-[9px] text-slate-500 font-mono\">Aligner</span>\n                </div>\n                <div className=\"flex gap-1.5\">\n                  <input\n                    type=\"number\"\n                    step=\"0.01\"\n                    min=\"0.01\"\n                    value={scenario.prixGasoilMoyen}\n                    onChange={e => setScenario(prev => ({ ...prev, prixGasoilMoyen: Math.max(0.01, Number(e.target.value)) }))}\n                    className=\"w-18 bg-slate-900 border border-slate-700 rounded-md px-2.5 py-1 text-xs font-mono text-center\"\n                  />\n                  <button\n                    onClick={handleSyncGasoilPrice}\n                    className=\"flex-1 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-[10px] font-bold transition flex items-center justify-center gap-1 py-1 px-1.5\"\n                    title=\"Synchroniser toutes les machines \303\240 ce tarif\"\n                  >\n                    <RefreshCcw className=\"h-3 w-3 shrink-0\" /> Propager\n                  </button>\n                </div>\n              </div>\n\n            </div>\n          )}\n\n          {/* Printable Report Header (Only visible when printing) */}\n          <div className=\"hidden print:block border-b border-slate-300 pb-5 mb-5\">\n            <div className=\"flex justify-between items-start\">\n              <div>\n                <h1 className=\"text-2xl font-black text-slate-900\">RAPPORT TECHNIQUE D\'EXPLOITATION & PRIX DE REVIENT</h1>\n                <p className=\"text-sm text-slate-500 font-mono\">Sc\303\251nario : {scenario.nom} | Date : {scenario.dateCreation}</p>\n              </div>\n              <div className=\"text-right\">\n                <div className=\"text-lg font-black text-blue-900\">PROD : {formatTonnage(scenario.productionTonnage)} ({scenario.periode === \'mensuel\' ? \'Mensuel\' : \'Annuel\'})</div>\n                <div className=\"text-xs text-slate-500 font-mono\">Devise : {scenario.devise}</div>\n              </div>\n            </div>\n          </div>\n\n          {/* Core App View Router */}\n          {activeTab === \'dashboard\' && (\n            <DashboardView scenario={scenario} />\n          )}\n\n          {activeTab === \'scenarios\' && (\n            <ScenarioManagerView\n              currentScenario={scenario}\n              onLoadScenario={handleLoadScenario}\n              onSaveCurrentScenario={handleSaveCurrentScenario}\n            />\n          )}\n\n          {activeTab !== \'dashboard\' && activeTab !== \'scenarios\' && (\n            <div className=\"space-y-6\">\n              {/* Process Description Header */}\n              <div className=\"rounded-xl border border-slate-100 bg-white p-6 shadow-xs\">\n                <div className=\"flex items-center gap-3 mb-2\">\n                  <div className=\"p-2.5 rounded-lg bg-blue-50 text-blue-700 shadow-3xs\">\n                    <Layers className=\"h-5 w-5\" />\n                  </div>\n                  <div>\n                    <h2 className=\"text-lg font-bold text-slate-900\">\n                      Processus : {scenario.processus[activeTab].nom}\n                    </h2>\n                    <p className=\"text-xs text-slate-500\">\n                      {scenario.processus[activeTab].description}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"p-3 bg-blue-50/20 rounded-lg border border-blue-50 text-[11px] text-blue-800 leading-normal flex gap-1.5 mt-4\">\n                  <BookOpen className=\"h-4.5 w-4.5 shrink-0 text-blue-500 mt-0.5\" />\n                  <span>\n                    Saisissez ci-dessous les engins internes, sous-traitances ou locations externes, le personnel d\303\251di\303\251 ainsi que les taxes sp\303\251cifiques li\303\251s au processus de <strong>{scenario.processus[activeTab].nom}</strong>. Les r\303\251sultats se consolident en temps r\303\251el sur le tableau de bord.\n                  </span>\n                </div>\n              </div>\n\n              <ProcessEditorView\n                processus={scenario.processus[activeTab]}\n                periode={scenario.periode}\n                productionTonnage={scenario.productionTonnage}\n                onUpdateProcessus={handleUpdateProcessus}\n                devise={scenario.devise}\n              />\n            </div>\n          )}\n\n          {/* Printing disclaimer */}\n          <div className=\"hidden print:block text-center text-[10px] text-slate-400 border-t border-slate-200 pt-8 mt-12 font-mono\">\n            G\303\251n\303\251r\303\251 automatiquement par l\'application Calculateur Prix de Revient Carri\303\250re. Sauvegardes stock\303\251es localement dans le navigateur.\n          </div>\n\n        </main>\n      </div>\n    </div>\n  );\n}\n"
    }
