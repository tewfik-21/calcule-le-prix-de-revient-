      target_content: "export const MetricCard: React.FC<MetricCardProps> = ({\n  title,\n  value,\n  subValue,\n  icon,\n  color = \'primary\',\n  id\n}) => {\n  const colorClasses = {\n    primary: \'border-blue-100 bg-blue-50/50 text-blue-900\',\n    success: \'border-emerald-100 bg-emerald-50/50 text-emerald-900\',\n    warning: \'border-amber-100 bg-amber-50/50 text-amber-900\',\n    danger: \'border-rose-100 bg-rose-50/50 text-rose-900\',\n    info: \'border-sky-100 bg-sky-50/50 text-sky-900\',\n    neutral: \'border-slate-100 bg-slate-50/50 text-slate-900\'\n  };\n\n  const dotClasses = {\n    primary: \'bg-blue-500\',\n    success: \'bg-emerald-500\',\n    warning: \'bg-amber-500\',\n    danger: \'bg-rose-500\',\n    info: \'bg-sky-500\',\n    neutral: \'bg-slate-500\'\n  };\n\n  return (\n    <div\n      id={id || `metric-card-${title.toLowerCase().replace(/\\s+/g, \'-\')}`}\n      className={`relative overflow-hidden rounded-xl border p-5 shadow-xs transition-all hover:shadow-md ${colorClasses[color]}`}\n    >\n      <div className=\"flex items-center justify-between\">\n        <span className=\"text-sm font-medium text-slate-600 dark:text-slate-500\">{title}</span>\n        <div className=\"p-2 rounded-lg bg-white/80 shadow-2xs text-slate-700\">\n          {icon}\n        </div>\n      </div>\n      <div className=\"mt-4\">\n        <h3 className=\"text-2xl font-bold tracking-tight text-slate-900\">{value}</h3>\n        {subValue && (\n          <p className=\"mt-1 text-xs text-slate-600 flex items-center gap-1.5 font-mono\">\n            <span className={`inline-block h-1.5 w-1.5 rounded-full ${dotClasses[color]}`} />\n            {subValue}\n          </p>\n        )}\n      </div>\n    </div>\n  );\n};"
