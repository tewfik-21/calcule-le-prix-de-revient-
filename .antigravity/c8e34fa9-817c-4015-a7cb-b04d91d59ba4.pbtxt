derLock className=\"h-4.5 w-4.5\" />\n                  Gestion des Sc\303\251narios\n                </button>\n              </nav>\n            </div>\n\n            {/* Production categories */}\n            <div>\n              <span className=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest block mb-3\">Rubriques de Production</span>\n              <nav className=\"space-y-2\">\n                {[\n                  { id: \'front_de_taille\', label: \'01. Front de Taille\', desc: \'Extraction & Forage\', icon: <Flame className=\"h-4 w-4\" /> },\n                  { id: \'transport\', label: \'02. Transport\', desc: \'Transfert au concasseur\', icon: <Truck className=\"h-4 w-4\" /> },\n                  { id: \'concassage\', label: \'03. Concassage\', desc: \'R\303\251duction & Criblage\', icon: <Hammer className=\"h-4 w-4\" /> },\n                  { id: \'chargement\', label: \'04. Chargement\', desc: \'Vente & Exp\303\251dition\', icon: <PackageCheck className=\"h-4 w-4\" /> },\n                  { id: \'moyens_generaux\', label: \'05. Moyens G\303\251n\303\251raux\', desc: \'Ateliers & Admin\', icon: <Briefcase className=\"h-4 w-4\" /> }\n                ].map((item) => (\n                  <button\n                    key={item.id}\n                    onClick={() => { setActiveTab(item.id as any); setMobileMenuOpen(false); }}\n                    className={`w-full text-left p-4 rounded-none border-2 transition flex flex-col ${\n                      activeTab === item.id\n                        ? \'bg-emerald-500 text-black border-emerald-500\'\n                        : \'text-zinc-400 bg-zinc-900/50 border-zinc-800 hover:bg-zinc-900/80 hover:text-white\'\n                    }`}\n                    id={`nav-btn-${item.id}`}\n                  >\n                    <div className=\"flex items-center gap-2 font-black text-xs uppercase tracking-wider\">\n                      {item.icon}\n                      <span>{item.label}</span>\