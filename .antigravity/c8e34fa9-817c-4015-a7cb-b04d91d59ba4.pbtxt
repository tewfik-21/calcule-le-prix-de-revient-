  file_change {
    absolute_path_uri: "file:///src/components/DashboardView.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "      {/* Charts Section */}\n      <div className=\"grid grid-cols-1 gap-8 lg:grid-cols-3\">\n        {/* Process Cost Bar Chart */}\n        <div className=\"lg:col-span-2 rounded-xl border border-slate-100 bg-white p-6 shadow-xs\" id=\"chart-bar-container\">\n          <div className=\"mb-4\">\n            <h3 className=\"text-base font-semibold text-slate-900 flex items-center gap-2\">\n              <Layers className=\"h-4.5 w-4.5 text-blue-600\" />\n              R\303\251partition des Co\303\273ts par Processus de Production\n            </h3>\n            <p className=\"text-xs text-slate-500\">Co\303\273ts cumul\303\251s exprim\303\251s en {scenario.devise}</p>\n          </div>\n          <div className=\"h-80 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <BarChart\n                data={barChartData}\n                margin={{ top: 10, right: 10, left: 20, bottom: 20 }}\n              >\n                <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#f1f5f9\" vertical={false} />\n                <XAxis dataKey=\"name\" stroke=\"#94a3b8\" fontSize={11} tickLine={false} />\n                <YAxis stroke=\"#94a3b8\" fontSize={11} tickLine={false} />\n                <Tooltip\n                  formatter={(value) => [formatCurrency(Number(value), scenario.devise), \'\']}\n                  contentStyle={{ backgroundColor: \'#ffffff\', borderRadius: \'8px\', border: \'1px solid #e2e8f0\', boxShadow: \'0 4px 6px -1px rgb(0 0 0 / 0.05)\' }}\n                />\n                <Legend iconType=\"circle\" wrapperStyle={{ fontSize: \'11px\', paddingTop: \'10px\' }} />\n                <Bar dataKey=\"Gasoil\" stackId=\"a\" fill=\"#3b82f6\" />\n                <Bar dataKey=\"Pi\303\250ces Rechange\" stackId=\"a\" fill=\"#10b981\" />\n                <Bar dataKey=\"Amortissement\" stackId=\"a\" fill=\"#8b5cf6\" />\n                <Bar dataKey=\"Location Externe\" stackId=\"a\" fill=\"#ec4899\" />\n                <Bar dataKey=\"Personnel\" stackId=\"a\" fill=\"#f59e0b\" />\n                <Bar dataKey=\"Taxes\" stackId=\"a\" fill=\"#64748b\" />\n              </BarChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n        {/* Nature Breakdown Pie Chart */}\n        <div className=\"rounded-xl border border-slate-100 bg-white p-6 shadow-xs\" id=\"chart-pie-container\">\n          <div className=\"mb-4\">\n            <h3 className=\"text-base font-semibold text-slate-900 flex items-center gap-2\">\n              <Activity className=\"h-4.5 w-4.5 text-blue-600\" />\n              Structure de Co\303\273t par Nature\n            </h3>\n            <p className=\"text-xs text-slate-500\">Pourcentage des d\303\251penses totales du site</p>\n          </div>\n          <div className=\"h-64 w-full flex items-center justify-center relative\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <PieChart>\n                <Pie\n                  data={pieChartData}\n                  cx=\"50%\"\n                  cy=\"50%\"\n                  innerRadius={60}\n                  outerRadius={80}\n                  paddingAngle={3}\n                  dataKey=\"value\"\n                >\n                  {pieChartData.map((entry, index) => {\n                    return <Cell key={`cell-${index}`} fill={entry.color} />;\n                  })}\n                </Pie>\n                <Tooltip formatter={(value) => [formatCurrency(Number(value), scenario.devise), \'\']} />\n              </PieChart>\n            </ResponsiveContainer>\n            <div className=\"absolute text-center\">\n              <span className=\"text-xs text-slate-500 block uppercase tracking-wider font-semibold\">Total</span>\n              <span className=\"text-lg font-bold text-slate-800\">{formatCurrency(totalGlobal, scenario.devise)}</span>\n            </div>\n          </div>\n          {/* Custom Legends list */}\n          <div className=\"mt-4 space-y-1.5 overflow-y-auto max-h-32 pr-1\">\n            {pieChartData.map((entry, idx) => {\n              const p = totalGlobal > 0 ? (entry.value / totalGlobal) * 100 : 0;\n              return (\n                <div key={idx} className=\"flex items-center justify-between text-xs font-medium text-slate-700\">\n                  <div className=\"flex items-center gap-2 truncate\">\n                    <span className=\"w-2.5 h-2.5 rounded-full shrink-0\" style={{ backgroundColor: entry.color }} />\n                    <span className=\"truncate\">{entry.name}</span>\n                  </div>\n                  <span className=\"font-mono text-slate-600 whitespace-nowrap\">{formatPercent(p)}</span>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n\n      {/* Analytical Cost Matrix Table */}\n      <div className=\"rounded-xl border border-slate-100 bg-white shadow-xs overflow-hidden\" id=\"cost-matrix-container\">\n        <div className=\"p-5 border-b border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div>\n            <h3 className=\"text-base font-semibold text-slate-900 flex items-center gap-2\">\n              <FileSpreadsheet className=\"h-4.5 w-4.5 text-blue-600\" />\n              Matrice de Co\303\273t Analytique Multi-Processus\n            </h3>\n            <p className=\"text-xs text-slate-500\">Tableau crois\303\251 global par rubrique de production et nature de charge</p>\n          </div>\n          <div className=\"text-xs font-mono text-slate-600 bg-white py-1 px-2.5 rounded border border-slate-100 whitespace-nowrap\">\n            Production : <strong className=\"text-slate-800\">{formatTonnage(scenario.productionTonnage)}</strong>\n          </div>\n        </div>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse\">\n            <thead>\n              <tr className=\"bg-slate-100/70 border-b border-slate-200 text-slate-700 font-bold uppercase tracking-wider text-[10px]\">\n                <th className=\"py-3 px-4 min-w-[150px]\">Processus / Rubrique</th>\n                <th className=\"py-3 px-3 text-right\">\n                  <div className=\"flex items-center justify-end gap-1 font-semibold\">\n                    <Fuel className=\"h-3 w-3\" /> Gasoil\n                  </div>\n                </th>\n                <th className=\"py-3 px-3 text-right\">\n                  <div className=\"flex items-center justify-end gap-1 font-semibold\">\n                    <Wrench className=\"h-3 w-3\" /> Pi\303\250ces Rch.\n                  </div>\n                </th>\n                <th className=\"py-3 px-3 text-right\">Amortissement</th>\n                <th className=\"py-3 px-3 text-right\">Location Ext.</th>\n                <th className=\"py-3 px-3 text-right\">\n                  <div className=\"flex items-center justify-end gap-1 font-semibold\">\n                    <Users className=\"h-3 w-3\" /> Personnel\n                  </div>\n                </th>\n                <th className=\"py-3 px-3 text-right\">Taxes & Imp\303\264ts</th>\n                <th className=\"py-3 px-4 text-right bg-blue-50/30 font-bold text-blue-900 border-l border-blue-100\">Co\303\273t Total</th>\n                <th className=\"py-3 px-4 text-right bg-indigo-50/30 font-bold text-indigo-900 border-l border-indigo-100\">Cout / Tonne</th>\n                <th className=\"py-3 px-4 text-center text-slate-600 border-l border-slate-200\">%</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 text-slate-700 font-medium\">\n              {items.map((item) => {\n                const personnelTotal = item.personnelPaieCout + item.personnelRepasCout + item.personnelHebergementCout;\n                return (\n                  <tr key={item.id} className=\"hover:bg-slate-50/60 transition-colors\">\n                    <td className=\"py-3.5 px-4 font-semibold text-slate-800\">\n                      <div>{item.nom}</div>\n                      <div className=\"text-[10px] text-slate-500 font-normal mt-0.5 truncate max-w-[200px]\">\n                        {item.id === \'front_de_taille\' && \'Abattage, Forage, Minage\'}\n                        {item.id === \'transport\' && \'Roulage engins & dumpers\'}\n                        {item.id === \'concassage\' && \'Traitement primaire & secondaire\'}\n                        {item.id === \'chargement\' && \'Exp\303\251dition clients\'}\n                        {item.id === \'moyens_generaux\' && \'Administration & Ateliers\'}\n                      </div>\n                    </td>\n                    <td className=\"py-3.5 px-3 text-right font-mono text-slate-600\">\n                      {item.gasoilCout > 0 ? formatCurrency(item.gasoilCout, \'\') : \'-\'}\n                    </td>\n                    <td className=\"py-3.5 px-3 text-right font-mono text-slate-600\">\n                      {item.piecesRechangeCout > 0 ? formatCurrency(item.piecesRechangeCout, \'\') : \'-\'}\n                    </td>\n                    <td className=\"py-3.5 px-3 text-right font-mono text-slate-600\">\n                      {item.amortissementCout > 0 ? formatCurrency(item.amortissementCout, \'\') : \'-\'}\n                    </td>\n                    <td className=\"py-3.5 px-3 text-right font-mono text-slate-600\">\n                      {item.locationCout > 0 ? formatCurrency(item.locationCout, \'\') : \'-\'}\n                    </td>\n                    <td className=\"py-3.5 px-3 text-right font-mono text-slate-600\">\n                      {personnelTotal > 0 ? formatCurrency(personnelTotal, \'\') : \'-\'}\n                      {personnelTotal > 0 && (\n                        <div className=\"text-[9px] text-slate-400 font-normal\">\n                          P: {Math.round(item.personnelPaieCout)} | R: {Math.round(item.personnelRepasCout)} | H: {Math.round(item.personnelHebergementCout)}\n                        </div>\n                      )}\n                    </td>\n                    <td className=\"py-3.5 px-3 text-right font-mono text-slate-600\">\n                      {item.taxesCout > 0 ? formatCurrency(item.taxesCout, \'\') : \'-\'}\n                    </td>\n                    <td className=\"py-3.5 px-4 text-right font-mono font-semibold text-blue-900 bg-blue-50/10 border-l border-blue-50\">\n                      {formatCurrency(item.totalCout, scenario.devise)}\n                    </td>\n                    <td className=\"py-3.5 px-4 text-right font-mono font-semibold text-indigo-900 bg-indigo-50/10 border-l border-indigo-50\">\n                      {formatCostPerTon(item.coutParTonne, scenario.devise)}\n                    </td>\n                    <td className=\"py-3.5 px-4 text-center font-mono text-slate-500 border-l border-slate-100\">\n                      {formatPercent(item.pourcentage)}\n                    </td>\n                  </tr>\n                );\n              })}\n\n              {/* Total Consolidated Row */}\n              <tr className=\"bg-slate-100/50 border-t-2 border-slate-300 text-slate-900 font-bold text-sm\">\n                <td className=\"py-4 px-4 font-bold text-slate-900\">TOTAL G\303\211N\303\211RAL</td>\n                <td className=\"py-4 px-3 text-right font-mono text-slate-800\">\n                  {formatCurrency(breakdownByCategory.gasoil, \'\')}\n                </td>\n                <td className=\"py-4 px-3 text-right font-mono text-slate-800\">\n                  {formatCurrency(breakdownByCategory.pieces, \'\')}\n                </td>\n                <td className=\"py-4 px-3 text-right font-mono text-slate-800\">\n                  {formatCurrency(breakdownByCategory.amortissement, \'\')}\n                </td>\n                <td className=\"py-4 px-3 text-right font-mono text-slate-800\">\n                  {formatCurrency(breakdownByCategory.location, \'\')}\n                </td>\n                <td className=\"py-4 px-3 text-right font-mono text-slate-800\">\n                  {formatCurrency(breakdownByCategory.personnelTotal, \'\')}\n                  <div className=\"text-[10px] text-slate-500 font-normal\">\n                    P: {Math.round(breakdownByCategory.personnelPaie)} | R: {Math.round(breakdownByCategory.personnelRepas)} | H: {Math.round(breakdownByCategory.personnelHebergement)}\n                  </div>\n                </td>\n                <td className=\"py-4 px-3 text-right font-mono text-slate-800\">\n                  {formatCurrency(breakdownByCategory.taxes, \'\')}\n                </td>\n                <td className=\"py-4 px-4 text-right font-mono font-bold text-blue-900 bg-blue-100/30 border-l border-blue-200\">\n                  {formatCurrency(totalGlobal, scenario.devise)}\n                </td>\n                <td className=\"py-4 px-4 text-right font-mono font-bold text-indigo-900 bg-indigo-100/30 border-l border-indigo-200\">\n                  {formatCostPerTon(coutParTonneGlobal, scenario.devise)}\n                </td>\n                <td className=\"py-4 px-4 text-center font-mono text-slate-800 border-l border-slate-200\">\n                  100%\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>"
      replacement_content: "      {/* Charts Section */}\n      <div className=\"grid grid-cols-1 gap-8 lg:grid-cols-3\">\n        {/* Process Cost Bar Chart */}\n        <div className=\"lg:col-span-2 border-2 border-zinc-800 bg-zinc-900 p-6\" id=\"chart-bar-container\">\n          <div className=\"mb-4\">\n            <h3 className=\"text-base font-black uppercase tracking-tight text-white flex items-center gap-2\">\n              <Layers className=\"h-4.5 w-4.5 text-emerald-500\" />\n              R\303\251partition des Co\303\273ts par Processus\n            </h3>\n            <p className=\"text-xs text-zinc-400 font-mono\">Co\303\273ts cumul\303\251s exprim\303\251s en {scenario.devise}</p>\n          </div>\n          <div className=\"h-80 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <BarChart\n                data={barChartData}\n                margin={{ top: 10, right: 10, left: 20, bottom: 20 }}\n              >\n                <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#27272a\" vertical={false} />\n                <XAxis dataKey=\"name\" stroke=\"#71717a\" fontSize={10} tickLine={false} />\n                <YAxis stroke=\"#71717a\" fontSize={10} tickLine={false} />\n                <Tooltip\n                  formatter={(value) => [formatCurrency(Number(value), scenario.devise), \'\']}\n                  contentStyle={{ backgroundColor: \'#18181b\', borderRadius: \'0px\', border: \'2px solid #27272a\', color: \'#ffffff\' }}\n                />\n                <Legend iconType=\"square\" wrapperStyle={{ fontSize: \'10px\', paddingTop: \'10px\', textTransform: \'uppercase\', fontWeight: \'bold\' }} />\n                <Bar dataKey=\"Gasoil\" stackId=\"a\" fill=\"#10b981\" />\n                <Bar dataKey=\"Pi\303\250ces Rechange\" stackId=\"a\" fill=\"#047857\" />\n                <Bar dataKey=\"Amortissement\" stackId=\"a\" fill=\"#ffffff\" />\n                <Bar dataKey=\"Location Externe\" stackId=\"a\" fill=\"#71717a\" />\n                <Bar dataKey=\"Personnel\" stackId=\"a\" fill=\"#e4e4e7\" />\n                <Bar dataKey=\"Taxes\" stackId=\"a\" fill=\"#27272a\" />\n              </BarChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n        {/* Nature Breakdown Pie Chart */}\n        <div className=\"border-2 border-zinc-800 bg-zinc-900 p-6\" id=\"chart-pie-container\">\n          <div className=\"mb-4\">\n            <h3 className=\"text-base font-black uppercase tracking-tight text-white flex items-center gap-2\">\n              <Activity className=\"h-4.5 w-4.5 text-emerald-500\" />\n              Structure par Nature\n            </h3>\n            <p className=\"text-xs text-zinc-400 font-mono\">Pourcentage des d\303\251penses totales</p>\n          </div>\n          <div className=\"h-64 w-full flex items-center justify-center relative\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <PieChart>\n                <Pie\n                  data={pieChartData}\n                  cx=\"50%\"\n                  cy=\"50%\"\n                  innerRadius={60}\n                  outerRadius={80}\n                  paddingAngle={3}\n                  dataKey=\"value\"\n                >\n                  {pieChartData.map((entry, index) => {\n                    // map custom elegant colors to match the theme\n                    const brutalistColors = [\n                      \'#10b981\', // gasoil: emerald-500\n                      \'#047857\', // pieces: emerald-700\n                      \'#ffffff\', // amortissement: white\n                      \'#71717a\', // location: zinc-500\n                      \'#e4e4e7\', // personnel: zinc-200\n                      \'#27272a\'  // taxes: zinc-800\n                    ];\n                    return <Cell key={`cell-${index}`} fill={brutalistColors[index % brutalistColors.length]} />;\n                  })}\n                </Pie>\n                <Tooltip formatter={(value) => [formatCurrency(Number(value), scenario.devise), \'\']} />\n              </PieChart>\n            </ResponsiveContainer>\n            <div className=\"absolute text-center\">\n              <span className=\"text-[10px] text-zinc-500 block uppercase tracking-widest font-black\">Total</span>\n              <span className=\"text-lg font-black text-white italic\">{formatCurrency(totalGlobal, scenario.devise)}</span>\n            </div>\n          </div>\n          {/* Custom Legends list */}\n          <div className=\"mt-4 space-y-1.5 overflow-y-auto max-h-32 pr-1\">\n            {pieChartData.map((entry, idx) => {\n              const p = totalGlobal > 0 ? (entry.value / totalGlobal) * 100 : 0;\n              const colors = [\'#10b981\', \'#047857\', \'#ffffff\', \'#71717a\', \'#e4e4e7\', \'#27272a\'];\n              const col = colors[idx % colors.length];\n              return (\n                <div key={idx} className=\"flex items-center justify-between text-xs font-bold text-zinc-300 uppercase tracking-wide\">\n                  <div className=\"flex items-center gap-2 truncate\">\n                    <span className=\"w-2.5 h-2.5 shrink-0\" style={{ backgroundColor: col }} />\n                    <span className=\"truncate\">{entry.name}</span>\n                  </div>\n                  <span className=\"font-mono text-zinc-400 whitespace-nowrap\">{formatPercent(p)}</span>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n\n      {/* Analytical Cost Matrix Table */}\n      <div className=\"border-2 border-zinc-800 bg-zinc-900 overflow-hidden\" id=\"cost-matrix-container\">\n        <div className=\"p-5 border-b-2 border-zinc-850 bg-zinc-950 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div>\n            <h3 className=\"text-base font-black uppercase tracking-tight text-white flex items-center gap-2\">\n              <FileSpreadsheet className=\"h-4.5 w-4.5 text-emerald-500\" />\n              Matrice de Co\303\273t Analytique\n            </h3>\n            <p className=\"text-xs text-zinc-400 font-mono\">Tableau crois\303\251 global par rubrique de production</p>\n          </div>\n          <div className=\"text-xs font-mono text-zinc-300 bg-zinc-900 py-1.5 px-3 border border-zinc-800 whitespace-nowrap\">\n            Production : <strong className=\"text-emerald-400 font-black\">{formatTonnage(scenario.productionTonnage)}</strong>\n          </div>\n        </div>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse\">\n            <thead>\n              <tr className=\"bg-zinc-950 border-b-2 border-zinc-800 text-zinc-400 font-black uppercase tracking-wider text-[10px]\">\n                <th className=\"py-3 px-4 min-w-[150px]\">Processus / Rubrique</th>\n                <th className=\"py-3 px-3 text-right\">\n                  <div className=\"flex items-center justify-end gap-1 font-black\">\n                    <Fuel className=\"h-3 w-3\" /> Gasoil\n                  </div>\n                </th>\n                <th className=\"py-3 px-3 text-right\">\n                  <div className=\"flex items-center justify-end gap-1 font-black\">\n                    <Wrench className=\"h-3 w-3\" /> Pi\303\250ces Rch.\n                  </div>\n                </th>\n                <th className=\"py-3 px-3 text-right font-black\">Amortissement</th>\n                <th className=\"py-3 px-3 text-right font-black\">Location Ext.</th>\n                <th className=\"py-3 px-3 text-right\">\n                  <div className=\"flex items-center justify-end gap-1 font-black\">\n                    <Users className=\"h-3 w-3\" /> Personnel\n                  </div>\n                </th>\n                <th className=\"py-3 px-3 text-right font-black\">Taxes & Imp\303\264ts</th>\n                <th className=\"py-3 px-4 text-right bg-emerald-500/10 font-black text-emerald-400 border-l border-zinc-800\">Co\303\273t Total</th>\n                <th className=\"py-3 px-4 text-right bg-zinc-950/40 font-black text-white border-l border-zinc-800\">Cout / Tonne</th>\n                <th className=\"py-3 px-4 text-center text-zinc-500 border-l border-zinc-800\">%</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-zinc-800 text-zinc-300 font-medium\">\n              {items.map((item) => {\n                const personnelTotal = item.personnelPaieCout + item.personnelRepasCout + item.personnelHebergementCout;\n                return (\n                  <tr key={item.id} className=\"hover:bg-zinc-850/30 transition-colors border-b border-zinc-850\">\n                    <td className=\"py-3.5 px-4 font-black uppercase text-white\">\n                      <div>{item.nom}</div>\n                      <div className=\"text-[10px] text-zinc-500 font-bold uppercase tracking-tight mt-0.5 truncate max-w-[200px]\">\n                        {item.id === \'front_de_taille\' && \'Abattage, Forage, Minage\'}\n                        {item.id === \'transport\' && \'Roulage engins & dumpers\'}\n                        {item.id === \'concassage\' && \'Traitement primaire & secondaire\'}\n                        {item.id === \'chargement\' && \'Exp\303\251dition clients\'}\n                        {item.id === \'moyens_generaux\' && \'Administration & Ateliers\'}\n                      </div>\n                    </td>\n                    <td className=\"py-3.5 px-3 text-right font-mono text-zinc-400\">\n                      {item.gasoilCout > 0 ? formatCurrency(item.gasoilCout, \'\') : \'-\'}\n                    </td>\n                    <td className=\"py-3.5 px-3 text-right font-mono text-zinc-400\">\n                      {item.piecesRechangeCout > 0 ? formatCurrency(item.piecesRechangeCout, \'\') : \'-\'}\n                    </td>\n                    <td className=\"py-3.5 px-3 text-right font-mono text-zinc-400\">\n                      {item.amortissementCout > 0 ? formatCurrency(item.amortissementCout, \'\') : \'-\'}\n                    </td>\n                    <td className=\"py-3.5 px-3 text-right font-mono text-zinc-400\">\n                      {item.locationCout > 0 ? formatCurrency(item.locationCout, \'\') : \'-\'}\n                    </td>\n                    <td className=\"py-3.5 px-3 text-right font-mono text-zinc-400\">\n                      {personnelTotal > 0 ? formatCurrency(personnelTotal, \'\') : \'-\'}\n                      {personnelTotal > 0 && (\n                        <div className=\"text-[9px] text-zinc-500 font-bold uppercase tracking-wide\">\n                          P: {Math.round(item.personnelPaieCout)} | R: {Math.round(item.personnelRepasCout)} | H: {Math.round(item.personnelHebergementCout)}\n                        </div>\n                      )}\n                    </td>\n                    <td className=\"py-3.5 px-3 text-right font-mono text-zinc-400\">\n                      {item.taxesCout > 0 ? formatCurrency(item.taxesCout, \'\') : \'-\'}\n                    </td>\n                    <td className=\"py-3.5 px-4 text-right font-mono font-black text-emerald-400 bg-emerald-500/5 border-l border-zinc-850\">\n                      {formatCurrency(item.totalCout, scenario.devise)}\n                    </td>\n                    <td className=\"py-3.5 px-4 text-right font-mono font-black text-white bg-zinc-950/40 border-l border-zinc-850\">\n                      {formatCostPerTon(item.coutParTonne, scenario.devise)}\n                    </td>\n                    <td className=\"py-3.5 px-4 text-center font-mono text-zinc-500 border-l border-zinc-850\">\n                      {formatPercent(item.pourcentage)}\n                    </td>\n                  </tr>\n                );\n              })}\n\n              {/* Total Consolidated Row */}\n              <tr className=\"bg-zinc-950 border-t-4 border-b-4 border-zinc-800 text-white font-black text-xs\">\n                <td className=\"py-4 px-4 font-black uppercase text-white\">TOTAL G\303\211N\303\211RAL</td>\n                <td className=\"py-4 px-3 text-right font-mono text-zinc-200\">\n                  {formatCurrency(breakdownByCategory.gasoil, \'\')}\n                </td>\n                <td className=\"py-4 px-3 text-right font-mono text-zinc-200\">\n                  {formatCurrency(breakdownByCategory.pieces, \'\')}\n                </td>\n                <td className=\"py-4 px-3 text-right font-mono text-zinc-200\">\n                  {formatCurrency(breakdownByCategory.amortissement, \'\')}\n                </td>\n                <td className=\"py-4 px-3 text-right font-mono text-zinc-200\">\n                  {formatCurrency(breakdownByCategory.location, \'\')}\n                </td>\n                <td className=\"py-4 px-3 text-right font-mono text-zinc-200\">\n                  {formatCurrency(breakdownByCategory.personnelTotal, \'\')}\n                  <div className=\"text-[10px] text-zinc-500 font-bold uppercase tracking-tight\">\n                    P: {Math.round(breakdownByCategory.personnelPaie)} | R: {Math.round(breakdownByCategory.personnelRepas)} | H: {Math.round(breakdownByCategory.personnelHebergement)}\n                  </div>\n                </td>\n                <td className=\"py-4 px-3 text-right font-mono text-zinc-200\">\n                  {formatCurrency(breakdownByCategory.taxes, \'\')}\n                </td>\n                <td className=\"py-4 px-4 text-right font-mono font-black text-emerald-400 bg-emerald-500/10 border-l border-zinc-800\">\n                  {formatCurrency(totalGlobal, scenario.devise)}\n                </td>\n                <td className=\"py-4 px-4 text-right font-mono font-black text-white bg-zinc-950/60 border-l border-zinc-800\">\n                  {formatCostPerTon(coutParTonneGlobal, scenario.devise)}\n                </td>\n                <td className=\"py-4 px-4 text-center font-mono text-zinc-500 border-l border-zinc-800\">\n                  100%\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>"
    }
