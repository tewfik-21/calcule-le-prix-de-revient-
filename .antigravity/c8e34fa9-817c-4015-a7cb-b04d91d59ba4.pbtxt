      replacement_content: "      {/* KPI Cards */}\n      <div className=\"grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4\">\n        <MetricCard\n          title=\"Co\303\273t Global de Revient\"\n          value={formatCurrency(totalGlobal, scenario.devise)}\n          subValue={`Sur la base de ${formatTonnage(scenario.productionTonnage)}`}\n          icon={<Coins className=\"h-5 w-5 text-emerald-500\" />}\n          color=\"primary\"\n          id=\"kpi-total-cost\"\n        />\n        <MetricCard\n          title=\"Co\303\273t Moyen de Revient\"\n          value={formatCostPerTon(coutParTonneGlobal, scenario.devise)}\n          subValue=\"Co\303\273t direct par tonne produite\"\n          icon={<Truck className=\"h-5 w-5 text-emerald-400\" />}\n          color=\"info\"\n          id=\"kpi-cost-per-tonne\"\n        />\n        <MetricCard\n          title=\"Chiffre d\'Affaires Estim\303\251\"\n          value={formatCurrency(totalVentes, scenario.devise)}\n          subValue={`Prix de vente : ${formatCurrency(scenario.prixVenteMoyenParTonne, scenario.devise)}/T`}\n          icon={<TrendingUp className=\"h-5 w-5 text-white\" />}\n          color=\"success\"\n          id=\"kpi-estimated-sales\"\n        />\n        <MetricCard\n          title=\"Marge d\'Exploitation\"\n          value={formatCurrency(margeGlobale, scenario.devise)}\n          subValue={`Rentabilit\303\251 : ${formatPercent(margePourcent)} (${formatCurrency(margeParTonne, scenario.devise)}/T)`}\n          icon={<Percent className=\"h-5 w-5 text-amber-500\" />}\n          color={margeGlobale >= 0 ? \"success\" : \"danger\"}\n          id=\"kpi-net-margin\"\n        />\n      </div>"
